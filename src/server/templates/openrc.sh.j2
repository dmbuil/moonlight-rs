#!/usr/bin/env bash
# Generated by Moonlight. Source it: `source <file>`; it asks for your password.
export OS_AUTH_URL={{ auth_url | sh }}
export OS_PROJECT_ID={{ tenant_id | sh }}
export OS_PROJECT_NAME={{ tenant_name | sh }}
export OS_USER_DOMAIN_NAME={{ user_domain_name | sh }}
unset OS_TENANT_ID
unset OS_TENANT_NAME
export OS_USERNAME={{ user.username | sh }}
echo "Please enter your OpenStack Password for project $OS_PROJECT_NAME as user $OS_USERNAME: "
read -sr OS_PASSWORD_INPUT
export OS_PASSWORD=$OS_PASSWORD_INPUT
{% if region %}
export OS_REGION_NAME={{ region | sh }}
{% else %}
unset OS_REGION_NAME
{% endif %}
export OS_INTERFACE={{ interface | sh }}
export OS_IDENTITY_API_VERSION={{ os_identity_api_version }}
