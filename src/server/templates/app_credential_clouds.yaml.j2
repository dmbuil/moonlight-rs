clouds:
  {{ cloud_name | yaml }}:
{% if profile %}
    profile: {{ profile | yaml }}
{% endif %}
    auth_type: "v3applicationcredential"
    auth:
{% if not profile %}
      auth_url: {{ auth_url | yaml }}
{% endif %}
      application_credential_id: {{ application_credential_id | yaml }}
      application_credential_secret: {{ application_credential_secret | yaml }}
{% if not profile %}
{% if region %}
    region_name: {{ region | yaml }}
{% endif %}
    interface: {{ interface | yaml }}
{% endif %}
