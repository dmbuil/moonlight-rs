/target

# Local configuration: holds the cookie key and the cloud's URLs.
moonlight.conf
moonlight.conf.*
!moonlight.conf.example
moonlight.conf.d/
.env
.env.*

# Backups and editor leftovers can be copies of the files above.
*.bak
*.orig
*~
*.swp

# Per-user Claude Code settings.
.claude/settings.local.json

# Server logs ([log] in moonlight.conf): they name the cloud's endpoints and users.
*.log
moonlight.log*
# The container's log folder (README, Container image), owned by uid 10001 and unreadable here.
logs/

# Tool caches.
.rumdl_cache/

# IA local config
.claude

# Personal remote-development launcher: names this machine's host, paths and browser.
/scripts/moonlight-remote.sh
# Personal container launcher (podman run with this machine's conf and log volume).
/moon.sh
